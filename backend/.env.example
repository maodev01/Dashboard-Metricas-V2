# API Keys
OPENWEATHER_API_KEY=tu_openweather_api_key_aqui
# Obtener gratis en: https://openweathermap.org/api

# Database Configuration
DATABASE_URL=sqlite:///./metrics.db
# Para PostgreSQL usar: postgresql://user:password@localhost:5432/metrics_db

# Application Settings
APP_NAME=Dashboard de Métricas
APP_VERSION=1.0.0
DEBUG=True

# CORS Settings
ALLOWED_ORIGINS=["*"]
# En producción cambiar a: ["https://tudominio.com"]

# Default Location
DEFAULT_CITY=Bucaramanga
DEFAULT_COUNTRY=CO
DEFAULT_LAT=7.1254
DEFAULT_LON=-73.1198

# Scheduler Configuration (actualización en minutos)
COLLECTION_INTERVAL_MINUTES=5
